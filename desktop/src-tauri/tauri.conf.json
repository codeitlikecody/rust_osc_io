{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "OSCMessenger",
    "version": "0.1.0",
    "identifier": "org.oscmessenger.desktop",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "OSCMessenger",
                "width": 1320,
                "height": 860,
                "minWidth": 980,
                "minHeight": 640
            }
        ],
        "security": {
            "capabilities": [
                "default"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all"
    }
}